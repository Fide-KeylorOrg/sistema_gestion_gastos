generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Usernames and emails are stored lowercased by the app, so @unique is case-insensitive in practice.
model User {
  id                    String       @id @default(uuid(7)) @db.Uuid
  fullName              String
  username              String       @unique
  email                 String       @unique
  passwordHash          String
  active                Boolean      @default(true)
  mustChangePassword    Boolean      @default(true)
  // Set with a temporary password (new user or reset): it stops working 48 h later (HU-11).
  tempPasswordExpiresAt DateTime?    @db.Timestamptz(3)
  passwordChangedAt     DateTime?    @db.Timestamptz(3)
  roleId                String       @db.Uuid
  role                  Role         @relation(fields: [roleId], references: [id])
  lastLoginAt           DateTime?    @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)
  sessions              Session[]
  auditLogs             AuditLog[]
  uploadedFiles         StoredFile[]
}

// permissions holds keys from PERMISSIONS in src/lib/permissions.ts; the app validates them on write.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  users       User[]
}

// id is the SHA-256 of the cookie token, so a database leak does not expose usable sessions.
model Session {
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

// Append-only: a trigger in the init migration rejects UPDATE and DELETE. Kept at least 24 months (HU-12).
// Also the history of users (HU-5) and employees (HU-26): filter by entityType + entityId.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz(3)
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String? // e.g. "User", "Role", "Employee"
  entityId   String?
  detail     Json?
  sensitive  Boolean  @default(false) // detail holds salary data: only shown with payroll.salaries

  @@index([at])
  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId, at])
}

// Uploaded files (stored in S3). Each file belongs to exactly one record, which points to it.
model StoredFile {
  id               String            @id @default(uuid(7)) @db.Uuid
  storageKey       String            @unique // S3 object key
  fileName         String
  mimeType         String
  sizeBytes        Int
  uploadedById     String            @db.Uuid
  uploadedBy       User              @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime          @default(now()) @db.Timestamptz(3)
  employeeDocument EmployeeDocument?
  leave            Leave?
  expense          Expense?
  expensePayment   ExpensePayment?
}

// ---------- Employees and payroll ----------
// Money is Decimal(14,2) in colones. Business dates are @db.Date (no time zone shifts).
// CHECK and EXCLUDE constraints Prisma can't express live at the end of the init migration.

enum IdType {
  NATIONAL_ID // cédula física
  DIMEX
  PASSPORT
}

enum SalaryBasis {
  MONTHLY // monthly salary, paid biweekly
  HOURLY
}

// Everyone works the jornada diurna (8 h a day, 48 h a week, Código de Trabajo art. 136): hours beyond it are overtime.
// Inactive requires the date and reason of the change (CHECK in the init migration).
model Employee {
  id                  String             @id @default(uuid(7)) @db.Uuid
  idType              IdType
  idNumber            String
  firstName           String
  lastName1           String
  lastName2           String?
  birthDate           DateTime           @db.Date
  email               String?
  phone               String?
  address             String?
  position            String
  hireDate            DateTime           @db.Date
  contractEndsOn      DateTime?          @db.Date // fixed-term contracts; shown in the calendar (HU-48)
  active              Boolean            @default(true)
  statusChangedAt     DateTime?          @db.Date
  statusReason        String?
  // Vacation days carried over when an existing employee is loaded; the balance is this + accrued - taken.
  openingVacationDays Decimal            @default(0) @db.Decimal(5, 1)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  salaries            EmployeeSalary[]
  payrollLines        PayrollLine[]
  timeEntries         TimeEntry[]
  leaves              Leave[]
  advances            SalaryAdvance[]
  documents           EmployeeDocument[]

  @@unique([idType, idNumber])
}

// Salary terms by effective date (HU-18): each row applies from effectiveFrom until the next row starts, so a
// change can be scheduled ahead. The salary for a payroll is the latest row with effectiveFrom <= periodStart.
model EmployeeSalary {
  id            String      @id @default(uuid(7)) @db.Uuid
  employeeId    String      @db.Uuid
  employee      Employee    @relation(fields: [employeeId], references: [id])
  salaryBasis   SalaryBasis
  baseSalary    Decimal     @db.Decimal(14, 2)
  effectiveFrom DateTime    @db.Date
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([employeeId, effectiveFrom])
}

enum DocumentType {
  NATIONAL_ID
  CONTRACT
  CRIMINAL_RECORD
  RECOMMENDATION_LETTER
  OTHER
}

// A new version points to the one it replaces; deleting only hides it, so the history stays (HU-29).
model EmployeeDocument {
  id         String            @id @default(uuid(7)) @db.Uuid
  employeeId String            @db.Uuid
  employee   Employee          @relation(fields: [employeeId], references: [id])
  type       DocumentType
  fileId     String            @unique @db.Uuid
  file       StoredFile        @relation(fields: [fileId], references: [id])
  replacesId String?           @unique @db.Uuid
  replaces   EmployeeDocument? @relation("DocumentVersions", fields: [replacesId], references: [id])
  replacedBy EmployeeDocument? @relation("DocumentVersions")
  deletedAt  DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  @@index([employeeId])
}

enum LeaveKind {
  VACATION
  SICK_LEAVE
}

// Who pays the sick leave (incapacidad). The administration still has to confirm the list.
enum SickLeaveType {
  CCSS
  INS
  OTHER
}

// Vacations (HU-27) and sick leave (HU-28) in one table, so the database can reject any overlap between them.
model Leave {
  id            String         @id @default(uuid(7)) @db.Uuid
  employeeId    String         @db.Uuid
  employee      Employee       @relation(fields: [employeeId], references: [id])
  kind          LeaveKind
  sickLeaveType SickLeaveType? // only for SICK_LEAVE
  startDate     DateTime       @db.Date
  endDate       DateTime       @db.Date
  days          Decimal        @db.Decimal(4, 1) // days counted under the rules in force; vacations subtract them from the balance
  proofFileId   String?        @unique @db.Uuid
  proofFile     StoredFile?    @relation(fields: [proofFileId], references: [id])
  voidedAt      DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  @@index([employeeId])
}

enum TimeEntryKind {
  OVERTIME
  UNPAID_LEAVE // permiso sin goce de salario
}

// Novedades of a draft payroll (HU-16). Locked once the payroll closes.
model TimeEntry {
  id         String        @id @default(uuid(7)) @db.Uuid
  employeeId String        @db.Uuid
  employee   Employee      @relation(fields: [employeeId], references: [id])
  payrollId  String        @db.Uuid
  payroll    Payroll       @relation(fields: [payrollId], references: [id])
  date       DateTime      @db.Date
  kind       TimeEntryKind
  hours      Decimal       @db.Decimal(5, 2)
  note       String?
  voidedAt   DateTime?     @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)

  @@index([employeeId])
  @@index([payrollId])
}

// Status is derived: voided, deducted (its payroll is closed) or pending (HU-31).
model SalaryAdvance {
  id         String    @id @default(uuid(7)) @db.Uuid
  employeeId String    @db.Uuid
  employee   Employee  @relation(fields: [employeeId], references: [id])
  payrollId  String    @db.Uuid // payroll it is deducted in
  payroll    Payroll   @relation(fields: [payrollId], references: [id])
  amount     Decimal   @db.Decimal(14, 2)
  date       DateTime  @db.Date
  note       String?
  voidedAt   DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([employeeId])
  @@index([payrollId])
}

// Calendar holidays (HU-45, HU-46).
model Holiday {
  id   String   @id @default(uuid(7)) @db.Uuid
  date DateTime @unique @db.Date
  name String
}

enum RateScope {
  EMPLOYEE // withheld from the salary
  EMPLOYER // paid by the employer on top of it
}

// Social-charge components (CCSS, Banco Popular, INS...). A new one needs calculation code too, so an enum is fine.
enum RateCode {
  SEM
  IVM
  BANCO_POPULAR
  ASIGNACIONES_FAMILIARES
  IMAS
  INA
  FCL
  OPC
  INS
}

// CCSS and related social charges, one row per component and validity period (HU-19). A change adds a row
// starting on its effective date; an old row only ever has its effectiveTo shortened, so past payrolls keep their rates.
model PayrollRate {
  id            String    @id @default(uuid(7)) @db.Uuid
  scope         RateScope
  code          RateCode
  percent       Decimal   @db.Decimal(6, 3)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime  @db.Date
  source        String
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([scope, code, effectiveFrom])
}

// Monthly income tax brackets for salaried workers; Hacienda publishes a new table each December (HU-19).
model IncomeTaxTable {
  id            String             @id @default(uuid(7)) @db.Uuid
  effectiveFrom DateTime           @unique @db.Date
  effectiveTo   DateTime           @db.Date
  source        String
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  brackets      IncomeTaxBracket[]
}

model IncomeTaxBracket {
  id         String         @id @default(uuid(7)) @db.Uuid
  tableId    String         @db.Uuid
  table      IncomeTaxTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  lowerBound Decimal        @db.Decimal(14, 2)
  upperBound Decimal?       @db.Decimal(14, 2) // null = no upper limit
  percent    Decimal        @db.Decimal(5, 2)

  @@unique([tableId, lowerBound])
}

// Paid biweekly. Draft until closedAt is set; closed payrolls are never recalculated.
model Payroll {
  id          String          @id @default(uuid(7)) @db.Uuid
  periodStart DateTime        @db.Date
  periodEnd   DateTime        @db.Date
  payDate     DateTime        @db.Date // scheduled payment date (dashboard "próximos pagos de planilla")
  closedAt    DateTime?       @db.Timestamptz(3)
  paidAt      DateTime?       @db.Date
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  lines       PayrollLine[]
  timeEntries TimeEntry[]
  advances    SalaryAdvance[]
}

// Snapshot of the salary terms used, so later changes to Employee never alter this payroll.
model PayrollLine {
  id          String        @id @default(uuid(7)) @db.Uuid
  payrollId   String        @db.Uuid
  payroll     Payroll       @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId  String        @db.Uuid
  employee    Employee      @relation(fields: [employeeId], references: [id])
  salaryBasis SalaryBasis
  baseSalary  Decimal       @db.Decimal(14, 2)
  items       PayrollItem[]

  @@unique([payrollId, employeeId])
  @@index([employeeId])
}

enum PayrollItemKind {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

// One row per concept on the pay slip. Gross, deductions and net are sums by kind, never stored.
// code values (e.g. ORDINARY, OVERTIME, CCSS_EMPLOYEE) get defined with the payroll calculation rules.
model PayrollItem {
  id          String          @id @default(uuid(7)) @db.Uuid
  lineId      String          @db.Uuid
  line        PayrollLine     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  kind        PayrollItemKind
  code        String
  description String
  quantity    Decimal?        @db.Decimal(10, 2)
  rate        Decimal?        @db.Decimal(12, 6)
  amount      Decimal         @db.Decimal(14, 2)

  @@index([lineId])
}

// ---------- Expenses ----------

// Names are unique ignoring case; the app checks with mode: "insensitive" before writing.
model ExpenseCategory {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  expenses    Expense[]
}

enum ExpenseKind {
  PAYMENT
  PERMIT // sanitary / commercial permits: the due date is the expiry date
}

enum Recurrence {
  NONE
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// What is owed and how often. Each date it falls due is an ExpenseDue; only the next one is created ahead of time.
model Expense {
  id               String          @id @default(uuid(7)) @db.Uuid
  concept          String
  categoryId       String          @db.Uuid
  category         ExpenseCategory @relation(fields: [categoryId], references: [id])
  kind             ExpenseKind     @default(PAYMENT)
  estimatedAmount  Decimal         @db.Decimal(14, 2)
  referenceNumber  String?
  notes            String?
  recurrence       Recurrence      @default(NONE)
  recurrenceEndsOn DateTime?       @db.Date
  notifyDaysBefore Int?            @default(7) // 1-10; null = notifications off
  extraRecipients  String[]
  attachmentFileId String?         @unique @db.Uuid // supporting document (HU-32)
  attachmentFile   StoredFile?     @relation(fields: [attachmentFileId], references: [id])
  deletedAt        DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  dues             ExpenseDue[]

  @@index([categoryId])
}

// Status is derived: paid if it has a payment that isn't voided, overdue if dueDate < today, otherwise pending.
model ExpenseDue {
  id                   String            @id @default(uuid(7)) @db.Uuid
  expenseId            String            @db.Uuid
  expense              Expense           @relation(fields: [expenseId], references: [id])
  dueDate              DateTime          @db.Date
  estimatedAmount      Decimal           @db.Decimal(14, 2) // copied from Expense, so later edits don't rewrite history
  // Set when paying the previous due created this one. Voiding that payment cancels this due if still untouched
  // (HU-39); paying again reactivates it (clears cancelledAt), so there is still one due per period.
  generatedByPaymentId String?           @unique @db.Uuid
  generatedByPayment   ExpensePayment?   @relation("GeneratedDue", fields: [generatedByPaymentId], references: [id])
  cancelledAt          DateTime?         @db.Timestamptz(3) // cancelled dues are ignored by status, alerts, calendar and dashboard
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  payments             ExpensePayment[]  @relation("DuePayments")
  notifications        NotificationLog[]

  @@unique([expenseId, dueDate])
  @@index([dueDate])
}

// Voided payments are kept with their reason (HU-39). At most one non-voided payment per due (EXCLUDE constraint).
model ExpensePayment {
  id            String      @id @default(uuid(7)) @db.Uuid
  dueId         String      @db.Uuid
  due           ExpenseDue  @relation("DuePayments", fields: [dueId], references: [id])
  paidAt        DateTime    @db.Date
  amount        Decimal     @db.Decimal(14, 2)
  receiptFileId String?     @unique @db.Uuid // payment receipt (HU-38)
  receiptFile   StoredFile? @relation(fields: [receiptFileId], references: [id])
  voidedAt      DateTime?   @db.Timestamptz(3)
  voidReason    String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  generatedDue  ExpenseDue? @relation("GeneratedDue")

  @@index([dueId])
}

// Receive every expense notification; Expense.extraRecipients are added on top (HU-36).
model NotificationRecipient {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

// One row per due and notice date, claimed before sending, so a reminder is never sent twice (HU-37).
// sentAt stays null until the email goes out; error holds the last failure for a retry.
model NotificationLog {
  id         BigInt     @id @default(autoincrement())
  dueId      String     @db.Uuid
  due        ExpenseDue @relation(fields: [dueId], references: [id])
  notifyOn   DateTime   @db.Date
  recipients String[]
  sentAt     DateTime?  @db.Timestamptz(3)
  error      String?
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([dueId, notifyOn])
}
