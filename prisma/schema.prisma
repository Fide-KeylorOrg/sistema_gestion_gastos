generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Usernames and emails are stored lowercased by the app, so @unique is case-insensitive in practice.
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  fullName           String
  username           String     @unique
  email              String     @unique
  passwordHash       String
  active             Boolean    @default(true)
  mustChangePassword Boolean    @default(true)
  roleId             String     @db.Uuid
  role               Role       @relation(fields: [roleId], references: [id])
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  auditLogs          AuditLog[]
}

// permissions holds keys from PERMISSIONS in src/lib/permissions.ts; the app validates them on write.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  users       User[]
}

// id is the SHA-256 of the cookie token, so a database leak does not expose usable sessions.
model Session {
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

// Append-only: a trigger in the init migration rejects UPDATE and DELETE.
model AuditLog {
  id      BigInt   @id @default(autoincrement())
  at      DateTime @default(now()) @db.Timestamptz(3)
  actorId String?  @db.Uuid
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action  String
  target  String?
  detail  Json?

  @@index([at])
  @@index([actorId])
}
